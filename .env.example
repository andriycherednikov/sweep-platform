# Local dev uses the existing host Postgres (port 5432), dedicated `sweep` database.
# Copy to .env and set the real password (never commit it).
DATABASE_URL=postgres://localuser:YOUR_PASSWORD@localhost:5432/sweep
# If the api runs inside a container instead, reach the host DB via host.docker.internal:
#   DATABASE_URL=postgres://localuser:YOUR_PASSWORD@host.docker.internal:5432/sweep
PORT=3000
# Phase 2 — football worker (human provides the real key; never commit it)
API_FOOTBALL_KEY=your-api-football-pro-key
WC_SEASON=2026

# Phase 5 — photos + admin
# PHOTOS_DIR holds pending/ (api-only) + approved/ (served at /photos)
PHOTOS_DIR=./photos-data
# bcrypt hash of the admin passcode — generate with: npm run admin:hash -w api -- <passcode>
ADMIN_PASSCODE=
# secret that signs the admin session cookie (any long random string)
SESSION_SECRET=
# allowed browser origin in prod (Phase 6); unused in dev
SITE_ORIGIN=http://localhost:5173

# Web — Google Analytics 4. The Measurement ID is baked into web/src/lib/analytics.js
# (a GA4 ID is public) and loads in PRODUCTION builds only. Optional overrides below:
#   VITE_GA_ID=G-XXXXXXXXXX   # point a build at a different GA4 property
#   VITE_GA_ID=               # empty string disables analytics in a prod build

# Multi-sweep tenancy (Plan A)
# Host that serves token-scoped sweeps; the community sweep stays Host-bound to its own host.
PLATFORM_HOST=worldcupsweep.yowiebay.au
# Browser-facing origin for outbound links (share links, magic links, Stripe returns).
# Defaults to https://$PLATFORM_HOST — only set it when the SPA is served elsewhere,
# e.g. local dev behind Vite: PUBLIC_ORIGIN=http://127.0.0.1:5173
# Secret-link token for the platform owner (super-admin) — mints/rotates sweeps. Keep private.
SUPER_ADMIN_TOKEN=

# Transactional mail (Resend). Required in production — the API refuses to boot without
# it, because the fallback prints sign-in links to stdout. MAIL_FROM must be on a domain
# verified in Resend with SPF and DKIM, or delivery silently goes to spam.
RESEND_API_KEY=
MAIL_FROM=The Sweep <hello@example.com>
