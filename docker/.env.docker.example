# =============================================================================
# Sweep Portal — production runtime environment
# =============================================================================
# Copy to `.env.docker` next to docker-compose.yml ON THE SERVER and fill in.
# Read by every container (migrate, api, worker). NEVER commit the filled copy.
#
# ⚠️ Compose interpolates `$` in this file — write a literal `$` as `$$`
#    (bcrypt hashes and some passwords need this).
#
# The web image needs no runtime env: the SPA uses relative API paths and the
# shared Caddy routes by path.
# =============================================================================

# --- Database (shared simulation-postgres, its own database) ---
DATABASE_URL=postgres://simulation:PASSWORD@simulation-postgres:5432/sweep_portal

# --- Server ---
NODE_ENV=production
PORT=3000
PHOTOS_DIR=/data/photos
# The browser-facing origin. Required in production — the api refuses to boot
# without it, and share links, sign-in links and checkout/portal returns are all
# built from it, so it must match the Caddy site block exactly.
PUBLIC_ORIGIN=https://sweep-portal.yowiebay.au

# --- Feed ---
# One API-Sports key covers football + basketball. The worker uses it; the SPA
# never calls the provider.
API_FOOTBALL_KEY=

# --- Secrets ---
# Signs session cookies. Generate with: openssl rand -base64 48
# REQUIRED in production — the api refuses to boot without it. Leaving it blank used
# to fall back to a secret published in this repo, which is admin-role forgery.
SESSION_SECRET=

# --- Stripe (test keys while the portal is a test deployment) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From the webhook endpoint pointing at <PUBLIC_ORIGIN>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Optional ---
# PHOTOS_AUTO_APPROVE=true   # skip the moderation queue
# ACCOUNT_SWEEP_CAP=3        # sweeps per account while on trial
# ACCOUNT_SWEEP_MAX=25       # sweeps per subscribed account (feed-abuse ceiling)

# Transactional mail (Resend). Required in production — the API refuses to boot without
# it, because the fallback prints sign-in links to stdout. MAIL_FROM must be on a domain
# verified in Resend with SPF and DKIM, or delivery silently goes to spam.
RESEND_API_KEY=
MAIL_FROM=The Sweep <hello@example.com>
